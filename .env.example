# ---------------------------------------------------------------------------
# GNS Jewellers — environment variables. Copy to .env.local for development.
# NEVER commit real values. See DEPLOYMENT.md for where each value comes from.
# ---------------------------------------------------------------------------

# --- Browser-safe (exposed to the client bundle) ---------------------------
# Supabase Dashboard › Project Settings › API › Project URL           [required]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard › Project Settings › API Keys › Publishable key  [required]
# (legacy "anon" JWT key also works). Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Public URL of the site, used for product links in WhatsApp messages and OAuth redirects [required]
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefix with NEXT_PUBLIC_) ---------------------------
# Cloudflare Dashboard › R2 › Manage API tokens (Object Read & Write, scoped to the bucket) [required for photos]
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=gns-jewellers-media
# Optional: override the S3 endpoint (e.g. a local S3-compatible server for tests). Leave empty for R2.
R2_ENDPOINT=

# Google AI Studio › API keys                                    [optional: AI assistance]
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Optional: plan allowances shown in Admin -> System Check (defaults: Supabase Free 500 MB, R2 free 10 GB)
DB_LIMIT_MB=500
STORAGE_LIMIT_GB=10
